{
    // 调试前会自动执行 build（launch.json 的 preLaunchTask 引用此 label）
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "detail": "dotnet build ExcelToGame.csproj",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/ExcelToGame.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "clear": true
            }
        },
        {
            "label": "run",
            "detail": "构建并运行一次导出",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/ExcelToGame.csproj",
                "--no-build",
                "--",
                "${workspaceFolder}",
                "${workspaceFolder}/OutputExp"
            ],
            "dependsOn": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        }
    ]
}
